<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The services on the Mac are plain http on the local network (co-signer, recovery provider, Next.js). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The Mac's address for the services: localhost in the Simulator; set it in the scheme for a device. -->
	<key>SQWServerHost</key>
	<string>$(SQW_SERVER_HOST)</string>
</dict>
</plist>
