# Copy to .env and fill in. Never commit .env.

# Services
COSIGNER_PORT=4001
RECOVERY_PORT=4002
# Server-to-server: services fetch each other's sealing keys directly, never through the phone
COSIGNER_URL=http://localhost:4001
RECOVERY_URL=http://localhost:4002
NEXT_PUBLIC_COSIGNER_URL=http://localhost:4001
NEXT_PUBLIC_RECOVERY_URL=http://localhost:4002

# Demo mode timers (seconds). Production values: 86400 (24h) and 172800 (48h)
LOOSENING_DELAY_SECONDS=30
RECOVERY_WAIT_SECONDS=60

# Chains
BITCOIN_NETWORK=signet
BITCOIN_ESPLORA_URL=https://mempool.space/signet/api
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base (M4): Swissquote's co-signer runs the bundler and the paymaster itself (no provider needed).
# Optional: ETH_SPONSOR_DAILY_CAP_OPS (Premium, default 50), NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL (app reads)

# Payment assistant (M5): Apertus via Hugging Face router (OpenAI-compatible)
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=swiss-ai/Apertus-v1.5-70B:publicai
HF_TOKEN=
