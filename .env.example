# Copy to .env and fill in. Never commit .env.

# Services
COSIGNER_PORT=4001
RECOVERY_PORT=4002
# Server-to-server: services fetch each other's sealing keys directly, never through the phone
COSIGNER_URL=http://localhost:4001
RECOVERY_URL=http://localhost:4002
NEXT_PUBLIC_COSIGNER_URL=http://localhost:4001
NEXT_PUBLIC_RECOVERY_URL=http://localhost:4002

# Demo mode timers (seconds). Production values: 86400 (24h) and 172800 (48h)
LOOSENING_DELAY_SECONDS=30
RECOVERY_WAIT_SECONDS=60

# Chains
BITCOIN_NETWORK=signet
BITCOIN_ESPLORA_URL=https://mempool.space/signet/api
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base (M4): Swissquote's co-signer runs the bundler and the paymaster itself (no provider needed).
# Optional: ETH_SPONSOR_DAILY_CAP_OPS (Premium, default 50), NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL (app reads)

# Payment assistant (M5): any OpenAI-compatible API, with a fallback model (same API and key unless
# LLM_FALLBACK_BASE_URL / LLM_FALLBACK_API_KEY are set).
# Groq (free tier, used for the demo while the Apertus accounts have no credit):
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b  LLM_FALLBACK_MODEL=qwen/qwen3.8-27b  LLM_API_KEY=gsk_...
# Apertus, the Swiss open model, on Public AI's own API (platform.publicai.co, needs credit):
LLM_BASE_URL=https://api.publicai.co/v1
LLM_MODEL=swiss-ai/apertus-v1.5-70b
LLM_FALLBACK_MODEL=swiss-ai/apertus-v1.5-8b
LLM_API_KEY=
# Or the Hugging Face router: leave LLM_BASE_URL and LLM_API_KEY empty, set HF_TOKEN and
# LLM_MODEL=swiss-ai/Apertus-8B-Instruct-2509:publicai
HF_TOKEN=
